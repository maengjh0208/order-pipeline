# 실제 백엔드(docker compose)에 붙을 때는 이 값들이 기본값이라 .env 없이도 동작한다.
# VITE_API_BASE_URL=http://localhost:8000        # order-saga-orchestrator (주문, SSE)
# VITE_INVENTORY_BASE_URL=http://localhost:8001  # inventory-service (상품 조회)

# mock 서버(frontend/mock-server)로 단독 개발할 때는 둘 다 4000으로 덮어쓴다:
# VITE_API_BASE_URL=http://localhost:4000
# VITE_INVENTORY_BASE_URL=http://localhost:4000
